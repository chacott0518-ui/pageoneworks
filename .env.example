# ────────────────────────────────────────────────────
# PAGEONEWORKS 환경변수 예시
# 실제 값은 .env.local에만 입력한다.
# .env.local은 Git 추적에서 제외됨 (.gitignore 참조)
# ────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 배포 및 색인
INDEXNOW_KEY=your_indexnow_key_here
DEPLOY_SECRET=your_deploy_secret_here

# 사이트 URL
NEXT_PUBLIC_SITE_URL=https://www.pageoneworks.com

# 카카오톡 공유 (JavaScript 키 — 카카오 디벨로퍼스 앱 > 플랫폼 키)
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# 상담 신청 연동
GOOGLE_APPS_SCRIPT_CONSULT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
CONSULT_NOTIFICATION_EMAIL=your_notification_email@example.com
